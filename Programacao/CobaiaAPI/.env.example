# ! Alteração de IA - Revisar: template de configuração da CobaiaAPI. Copie para .env e
# ajuste se necessário; os valores default já batem com
# Programacao/CobaiaFront/conn/connect.php.
# ! Motivo: só o template é versionado — o .env real fica fora do git porque carrega
# ADMIN_TOKEN e credencial local. Os defaults repetem os do connect.php (root sem senha,
# banco ti93phpdb01) porque os dois alvos compartilham o mesmo banco de propósito; se
# divergissem, a API leria dados diferentes dos que o site PHP mostra.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ti93phpdb01

FAULT_MODE=normal
ADMIN_TOKEN=troque-isto-localmente
