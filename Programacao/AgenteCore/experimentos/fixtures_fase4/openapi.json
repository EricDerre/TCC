        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "post": {
    "tags": [
     "pedidos"
    ],
    "summary": "Criar Pedido",
    "description": "Mesma operação que Programacao/CobaiaFront/cliente/registrar_reserva.php\nfaz via SQL direto — mesma tabela, mesmo status inicial.",
    "operationId": "criar_pedido_api_pedidos_post",
    "requestBody": {
     "required": true,
